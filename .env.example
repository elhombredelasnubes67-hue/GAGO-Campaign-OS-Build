# GAGO CAMPAIGN OS — Variables de entorno
# Copiar a .env y completar valores reales

# Base de datos PostgreSQL (obligatorio para producción)
DATABASE_URL=postgresql://user:password@localhost:5432/gago_campaigns

# URL pública de la aplicación (para CORS y cookies)
APP_ORIGIN=http://localhost:3000

# Entorno: development | production
APP_ENV=development

# Duración de sesión en horas
SESSION_TTL_HOURS=24

# NO añadir variables VITE_* con secretos
# El frontend solo recibe configuración pública
